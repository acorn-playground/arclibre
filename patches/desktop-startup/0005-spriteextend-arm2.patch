+      	; ArcLibre ARM2 translation of the pinned c/SpriteOp check_sprite_area.
+; Copyright 1996 Acorn Computers Ltd; modifications 2026 ArcLibre contributors.
+; Apache-2.0, as the original source. Return 0 for valid, 1 for invalid.
+; Retains signed comparisons and the original old/new mask-size rules.
+check_sprite_area
+        Push    "r4-r12,lr"
+        LDR     r1,[r0]
+        LDR     r3,[r0,#4]
+        LDR     r4,[r0,#8]
+        LDR     r5,[r0,#12]
+        CMP     r4,r5
+        BGT     check_area_bad
+        CMP     r5,r1
+        BGT     check_area_bad
+        ADD     r2,r0,r1
+        ADD     r4,r0,r4
+        CMP     r3,#0
+        BLE     check_area_good
+check_area_loop
+        LDR     r5,[r4]
+        ADD     lr,r4,r5
+        CMP     lr,r2
+        BGT     check_area_bad
+        ADD     lr,r4,#16
+        LDMIA   lr,{r6-r12}
+        CMP     r8,#31
+        BGT     check_area_bad
+        CMP     r9,#31
+        BGT     check_area_bad
+        ADD     lr,r4,r10
+        CMP     lr,r2
+        BGT     check_area_bad
+        ADD     lr,r4,r11
+        CMP     lr,r2
+        BGT     check_area_bad
+        MOV     lr,r12,ASR #24
+        CMP     lr,#0
+        BLE     check_area_first_ok
+        CMP     r8,#0
+        BNE     check_area_bad
+check_area_first_ok
+        ADD     r0,r6,#1
+        ADD     r1,r7,#1
+        MUL     lr,r0,r1
+        MOV     lr,lr,LSL #2
+        ADD     r0,lr,r10
+        CMP     r10,r11
+        BEQ     check_area_no_mask
+        CMP     r0,r11
+        BGT     check_area_bad
+        MOVS    r0,r12,ASR #24
+        BNE     check_area_new_mask
+        ADD     r0,lr,r11
+        CMP     r0,r5
+        BGT     check_area_bad
+        SUB     r0,r5,r11
+        SUB     r1,r11,r10
+        CMP     r0,r1
+        BNE     check_area_bad
+        B       check_area_offsets
+check_area_new_mask
+        CMP     r12,#255
+        BLE     check_area_mode_ok
+        TST     r12,#1
+        BEQ     check_area_bad
+check_area_mode_ok
+        Push    "r2-r3"
+        MOV     r0,r12
+        MOV     r1,#9
+        SWI     XOS_ReadModeVariable
+        MOV     r0,r2
+        Pull    "r2-r3"
+        BVS     check_area_bad
+        RSB     r1,r0,#5
+        MOV     r1,r6,LSL r1
+        ADD     lr,r9,#1
+        ADD     r1,r1,lr,ASR r0
+        ADD     r1,r1,#31
+        BIC     r1,r1,#31
+        MOV     r1,r1,ASR #3
+        ADD     lr,r7,#1
+        MUL     r0,r1,lr
+        ADD     r0,r0,r11
+        CMP     r0,r5
+        BNE     check_area_bad
+        B       check_area_offsets
+check_area_no_mask
+        CMP     r0,r5
+        BGT     check_area_bad
+check_area_offsets
+        ORR     r0,r5,r10
+        ORR     r0,r0,r11
+        TST     r0,#3
+        BNE     check_area_bad
+        ADD     r4,r4,r5
+        SUBS    r3,r3,#1
+        BEQ     check_area_good
+        ADD     r0,r4,#44
+        CMP     r0,r2
+        BGT     check_area_bad
+        B       check_area_loop
+check_area_good
+        MOV     r0,#0
+        Pull    "r4-r12,pc"
+check_area_bad
+        MOV     r0,#1
+        Pull    "r4-r12,pc"
+
+        END
