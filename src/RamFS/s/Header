; >Header

        TTL     "Module header"
; LEADR omitted: explicit relocatable code area.
org

;Module Header
        ASSERT  {PC}-org=0
        & 0                     ;no start entry
        & InitEntry     - org
        & DieEntry      - org
        & 0                     ;no ServiceEntry
        & RamFSTitle    - org
        & RamFSHelpString - org
        & ComTab        - org
        & RamFSSwiBase
        & SwiEntry      - org
        & SwiNames      - org
        & 0                     ;no SWI name decoding code
 [ International_Help <> 0
        & message_filename - org
 |
        & 0
 ]
        ASSERT  {PC}-org=48

RamFSBootText
        =       "Acorn "        ;includes AdfsTitle
RamFSTitle
        Text    "RamFS"


RamFSHelpString
        =       "RamFS",9,9
        [ Dev
        =       DevVersion," DEVELOPMENT VERSION",0
        |
        =       version," (",date,")",0
        ]
        ALIGN
        END
