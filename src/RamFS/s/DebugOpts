; >DebugOpts

        GBLL    Dev
Dev     SETL    test_version

;Debug message switches
        [ Dev
        GBLL    Debug
Debug   SETL    F
        ]

        GBLL    Debug3
        GBLL    Debug4
        GBLL    Debug9

        MACRO
$a      switch  $b
       [ Dev
        [ Debug
$a      SETL    $b
        |
$a      SETL    F
        ]
       |
$a      SETL    F
       ]

        MEND

Debug3  switch  T       ;low level op
Debug4  switch  F ;F       ;misc op
Debug9  switch  T       ;useful routines

        GBLL    SpoolOff
SpoolOff SETL   F       ;T to disable spooling for debug messages
        GBLL    IrqDebug
IrqDebug SETL   F

        END
