        ADD r1,r12,#Palette
        MOV r2,#0
        SWI XWimp_ReadPalette
        LDMFD sp!,{pc}
 ; r0 = palette word index for the current selection (swatch, border, pointer).
SelectedEntry
        LDR r0,[r12,#Selected]
        MOV pc,lr
 ; r0 = flags for swatch r8: its own background colour, contrasting text.
SwatchFlags
        STMFD sp!,{r1,lr}
        LDR r0,SwatchBase
        ORR r0,r0,r8,LSL #28
        ADRL r1,Contrast
        LDRB r1,[r1,r8]
        ORR r0,r0,r1,LSL #24
        LDMFD sp!,{r1,pc}
 ; Create r8 icons from 32-byte definitions at r9 in r0 (default: Window).
MakeIcons
        LDR r0,[r12,#Window]
MakeIconsIn
        STMFD sp!,{r4,lr}
        MOV r4,r0
MakeIcon
        ADD r1,r12,#Block
        STR r4,[r1],#4
        MOV r0,r9
        MOV r2,#32
        BL Copy
        ADD r9,r9,#32
        MOV r0,#0
        ADD r1,r12,#Block
        SWI XWimp_CreateIcon
        BVS MakeIconsDone
        SUBS r8,r8,#1
        BNE MakeIcon
MakeIconsDone
        LDMFD sp!,{r4,pc}
 ; Show the selection: its number in the swatch, or the control inverted.
Refresh
        STMFD sp!,{r4-r9,lr}
        BL Read
        BVS RefreshDone
        MOV r8,#0
RefreshSwatch
        ADD r0,r12,#SwatchText
        ADD r0,r0,r8,LSL #2
        LDR r2,[r12,#Selected]
        CMP r2,r8
        MOVNE r3,#0
        BNE RefreshText
        CMP r8,#10
        MOVLT r3,#'0'
        ADDLT r3,r3,r8
        SUBGE r3,r8,#10
        ADDGE r3,r3,#'0'
        MOVGE r4,#'1'
        ORRGE r3,r4,r3,LSL #8
RefreshText
        STR r3,[r0]
        ADD r1,r12,#Block
        LDR r0,[r12,#Window]
        STR r0,[r1]
        STR r8,[r1,#4]
        LDR r2,[r12,#Selected]
        CMP r2,r8
        MOVEQ r0,#4                      ; outline the selected swatch
        MOVNE r0,#0
        STR r0,[r1,#8]
        MOV r0,#4
        STR r0,[r1,#12]
        SWI XWimp_SetIconState
        BVS RefreshDone
        ADD r8,r8,#1
        CMP r8,#16
        BNE RefreshSwatch
RefreshControl
        ADD r1,r12,#Block
        LDR r0,[r12,#Window]
        STR r0,[r1]
        STR r8,[r1,#4]
        LDR r2,[r12,#Selected]
        CMP r2,r8
        MOVEQ r0,#&70000000              ; inverted: black background, white text
        MOVNE r0,#&07000000              ; white background, black text
        STR r0,[r1,#8]
        MOV r0,#&FF000000
        STR r0,[r1,#12]
        SWI XWimp_SetIconState
        BVS RefreshDone
        ADD r8,r8,#1
        CMP r8,#20
        BNE RefreshControl
        BL ResizeSliders
RefreshDone
        LDMFD sp!,{r4-r9,pc}
 ; Slider fills are real window icons, resized through the maintained Wimp API.
ResizeSliders
        STMFD sp!,{r8-r10,lr}
        BL SelectedEntry
        ADD r1,r12,#Palette
        LDR r10,[r1,r0,LSL #2]
        MOV r8,#0
ResizeSlider
        MOV r3,r8,LSL #3
        ADD r3,r3,#12
        MOV r4,r10,LSR r3
        AND r4,r4,#15
        MOV r2,r4,LSL #4                 ; 16 OS units per step, full at 240
        ADD r4,r2,#20
        MOV r2,#32
        MUL r3,r8,r2
        RSB r3,r3,#0
        SUB r5,r3,#20                    ; fill top, inside the outline
        SUB r3,r3,#36                    ; fill bottom
        MOV r2,#20
        ADD r1,r8,#23
        LDR r0,[r12,#Window]
        SWI XWimp_ResizeIcon
        BVS ResizeDone
        ADD r8,r8,#1
        CMP r8,#3
        BNE ResizeSlider
        LDR r0,[r12,#Window]             ; redraw the slider band
        MOV r1,#0
        MOV r2,#-112
        MOV r3,#288
        MOV r4,#0
        SWI XWimp_ForceRedraw
ResizeDone
        LDMFD sp!,{r8-r10,pc}

