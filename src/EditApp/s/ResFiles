; > ResFiles
;
; ArcLibre: preserve the source catalogue's ,ffb file type explicitly.
; Unix copies lack RISC OS metadata; :FLOAD: otherwise defaults to Text and
; recurses through Edit's text-file alias instead of running BBC BASIC.
        DCD     ExportEnd - .
        DCD     &FFFFFB00, 0, :FSIZE:"Resources.Export", 3
        DCB     "Resources.Edit.Export",0
        ALIGN
        DCD     ExportDataEnd - ExportData + 4
ExportData
        BIN     Resources.Export
ExportDataEnd
        ALIGN
ExportEnd

        END
