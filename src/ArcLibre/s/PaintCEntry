; The original module wrapper and SharedCLibrary perform C startup.
; Compile the Paint body with main=ArcLibre_PaintMain so GCC does not
; inject its alternative __gccmain constructor runtime into this C program.
; Preserve the original library's weak main entry with a real tail call.
        AREA |C$$code|, CODE, READONLY
        IMPORT |ArcLibre_PaintMain|
        EXPORT |main|
|main|
        B |ArcLibre_PaintMain|
        END
