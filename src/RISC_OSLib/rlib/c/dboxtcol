/*dboxtcol.c - edit a true colour in the application's "dboxtcol" dialogue*/

/* Purpose

      Display a dialogue box which shows a true colour value, and which can
   be edited. If the user edits it (or presses OK) then update the colour
   variable and return TRUE. Allow_transparent enables selection of a
   "see-through" colour.

*/

/* History

   14 July 1993 JRC Use ColourPicker, replacing code by A P Thompson.
   2026 ArcLibre: ColourPicker is not part of an Archimedes ROM, so drive the
      "dboxtcol" template (red, green and blue percentages with arrows and
      bars, the 16 desktop colours, None, a colour patch and OK) again.
*/

#include <stdlib.h>
#include <string.h>

/*From RISC_OSLib*/
#include "bbc.h"
#include "colourtran.h"
#include "dbox.h"
#include "dboxtcol.h"
#include "template.h"
#include "wimp.h"
#include "wimpt.h"
#include "win.h"

#undef  NULL
#define NULL 0

/*Icons in the template. Each component c (red, green, blue) has the five
   icons Field (c) to Field (c) + 4.*/
#define I_OK          0
#define Field(c)      (1 + 5*(c))
#define I_MORE        0
#define I_LESS        1
#define I_PERCENT     2
#define I_BAR         3
#define I_PATCH       16
#define I_WIMPCOLOUR  17
#define I_NONE        33

static dbox D;
static int Value [3];  /*0..255 for red, green, blue*/
static int Shown [3];  /*percentage in the writable field*/
static BOOL Transparent;
static int Dragging;   /*component whose bar is being dragged, or -1*/

static int Percent (int v) {return (v*100 + 127)/255;}

static int Byte (int p) {return p < 0? 0: p > 100? 255: (p*255 + 50)/100;}

static dboxtcol_colour Colour (void)

{  return Transparent? dboxtcol_Transparent:
         Value [0] << 8 | Value [1] << 16 | Value [2] << 24;
}

/*Fill a box in a true colour, or in the window's background colour if
   background is set.*/
static void Fill (BOOL background, int c, int x0, int y0, int x1, int y1)

{  if (x1 > x0 && y1 > y0)
   {  if (background)
         wimpt_noerr (wimp_setcolour (1));
      else
      {  wimp_paletteword p;
         int gcol;

         p.word = c;
         wimpt_noerr (colourtran_setGCOL (p, 0, 0, &gcol));
      }
      wimpt_noerr (bbc_rectanglefill (x0, y0, x1 - x0 - 1, y1 - y0 - 1));
   }
}

/*Paint the bars and the patch into a redraw rectangle.*/
static void Paint (wimp_redrawstr *r)

{  int ox = r->box.x0 - r->scx, oy = r->box.y1 - r->scy, c, split;
   wimp_icon i;

   for (c = 0; c < 3; c++)
   {  wimpt_noerr (wimp_get_icon_info (r->w, Field (c) + I_BAR, &i));
      i.box.x0 += ox + 4, i.box.x1 += ox - 4;
      i.box.y0 += oy + 4, i.box.y1 += oy - 4;
      split = i.box.x0 + (i.box.x1 - i.box.x0)*Value [c]/255;
      Fill (FALSE, (int) (0xFF00u << 8*c), i.box.x0, i.box.y0, split,
            i.box.y1);
      Fill (TRUE, 0, split, i.box.y0, i.box.x1, i.box.y1);
   }

   wimpt_noerr (wimp_get_icon_info (r->w, I_PATCH, &i));
   Fill (Transparent, Colour (), i.box.x0 + ox + 4, i.box.y0 + oy + 4,
         i.box.x1 + ox - 4, i.box.y1 + oy - 4);
}

/*Bring the fields, bars and patch up to date.*/
static void Show (void)

{  wimp_w w = dbox_syshandle (D);
   wimp_redrawstr r;
   wimp_icon i;
   BOOL more;
   int c;

   for (c = 0; c < 3; c++)
      if (Shown [c] != Percent (Value [c]))
         dbox_setnumeric (D, Field (c) + I_PERCENT,
               Shown [c] = Percent (Value [c]));
   dbox_setnumeric (D, I_NONE, Transparent);

   /*The bars and the patch lie between the top bar and the patch.*/
   wimpt_noerr (wimp_get_icon_info (w, Field (0) + I_BAR, &i));
   r.w = w;
   r.box = i.box;
   wimpt_noerr (wimp_get_icon_info (w, I_PATCH, &i));
   r.box.y0 = i.box.y0;
   if (i.box.x0 < r.box.x0) r.box.x0 = i.box.x0;
   if (i.box.x1 > r.box.x1) r.box.x1 = i.box.x1;
   wimpt_noerr (wimp_update_wind (&r, &more));
   while (more)
   {  Paint (&r);
      wimpt_noerr (wimp_get_rectangle (&r, &more));
   }
}

/*Set component c from the pointer's position over its bar.*/
static void Drag (int c)

{  wimp_mousestr m;
   wimp_wstate s;
   wimp_icon i;
   int x0, x1;

   wimpt_noerr (wimp_get_point_info (&m));
   if ((m.bbits & (wimp_BLEFT | wimp_BRIGHT)) == 0)
   {  Dragging = -1;
      return;
   }
   wimpt_noerr (wimp_get_wind_state (dbox_syshandle (D), &s));
   wimpt_noerr (wimp_get_icon_info (dbox_syshandle (D), Field (c) + I_BAR, &i));
   x0 = s.o.box.x0 - s.o.x + i.box.x0 + 4;
   x1 = s.o.box.x0 - s.o.x + i.box.x1 - 4;
   m.x = m.x < x0? x0: m.x > x1? x1: m.x;
   if (Value [c] != (m.x - x0)*255/(x1 - x0) || Transparent)
   {  Value [c] = (m.x - x0)*255/(x1 - x0);
      Transparent = FALSE;
      Show ();
   }
}

/*Take a typed percentage as soon as it is a valid one.*/
static void Typed (void)

{  char a [8];
   int c, p;

   for (c = 0; c < 3; c++)
   {  dbox_getfield (D, Field (c) + I_PERCENT, a, sizeof a);
      if (a [0] != '\0' && (p = atoi (a)) <= 100 && p != Shown [c])
      {  Value [c] = Byte (p);
         Shown [c] = p;
         Transparent = FALSE;
         Show ();
      }
   }
}

static BOOL Events (dbox d, void *event, void *handle)

{  wimp_eventstr *e = (wimp_eventstr *) event;
   int c;

   d = d, handle = handle;
   switch (e->e)
   {  case wimp_EREDRAW:
      {  wimp_redrawstr r;
         BOOL more;

         r.w = e->data.o.w;
         wimpt_noerr (wimp_redraw_wind (&r, &more));
         while (more)
         {  Paint (&r);
            wimpt_noerr (wimp_get_rectangle (&r, &more));
         }
         return TRUE;
      }

      case wimp_ENULL:
         if (Dragging >= 0) Drag (Dragging);
         Typed ();
         return TRUE;

      case wimp_EBUT:
         for (c = 0; c < 3; c++)
            if (e->data.but.m.i == Field (c) + I_BAR &&
                  (e->data.but.m.bbits & wimp_BMID) == 0)
            {  Dragging = c;
               Drag (c);
               return TRUE;
            }
      break;
   }
   return FALSE;
}

BOOL dboxtcol (dboxtcol_colour *colour, BOOL allow_transparent,
      char *name, dboxtcol_colourhandler proc, void *handle)

{  template *t = template_find ("dboxtcol");
   wimp_w idler = win_idle_event_claimer ();
   wimp_palettestr palette;
   dbox_field f;
   BOOL chosen = FALSE, first = TRUE;
   int c, step;

   if (t == NULL) return FALSE;
   if ((t->window.titleflags & wimp_INDIRECT) != 0)
   {  strncpy (t->window.title.indirecttext.buffer, name,
            t->window.title.indirecttext.bufflen - 1);
      t->window.title.indirecttext.buffer
            [t->window.title.indirecttext.bufflen - 1] = '\0';
   }
   if ((D = dbox_new ("dboxtcol")) == NULL) return FALSE;

   Transparent = allow_transparent && *colour == dboxtcol_Transparent;
   for (c = 0; c < 3; c++)
   {  Value [c] = Transparent? 255: (*colour >> 8*(c + 1)) & 0xFF;
      dbox_setnumeric (D, Field (c) + I_PERCENT, Shown [c] = Percent (Value [c]));
   }
   if (!allow_transparent) dbox_fadefield (D, I_NONE);
   dbox_setnumeric (D, I_NONE, Transparent);
   Dragging = -1;

   dbox_raw_eventhandler (D, &Events, NULL);
   win_claim_idle_events (dbox_syshandle (D));
   dbox_show (D);

   for (;;)
   {  f = first? dbox_fillin (D): dbox_fillin_fixedcaret (D);
      first = FALSE;
      if (f == dbox_CLOSE) break;

      step = dbox_persist ()? -1: 1;
      if (f == I_OK)
      {  Typed ();
         *colour = Colour ();
         chosen = TRUE;
         if (proc != NULL) (*proc) (*colour, handle);
         if (step == 1) break;
      }
      else if (f == I_NONE)
      {  if (allow_transparent) Transparent = !Transparent;
         Show ();
      }
      else if (f >= I_WIMPCOLOUR && f < I_WIMPCOLOUR + 16)
      {  wimpt_noerr (wimp_readpalette (&palette));
         for (c = 0; c < 3; c++)
            Value [c] = (palette.c [f - I_WIMPCOLOUR].word >> 8*(c + 1)) & 0xFF;
         Transparent = FALSE;
         Show ();
      }
      else
         for (c = 0; c < 3; c++)
            if (f == Field (c) + I_MORE || f == Field (c) + I_LESS)
            {  /*Adjust reverses the arrows.*/
               int p = Percent (Value [c]) +
                     (f == Field (c) + I_MORE? step: -step);

               if (p >= 0 && p <= 100) Value [c] = Byte (p);
               Transparent = FALSE;
               Show ();
            }
   }

   win_claim_idle_events (idler);
   dbox_dispose (&D);
   return chosen;
}
