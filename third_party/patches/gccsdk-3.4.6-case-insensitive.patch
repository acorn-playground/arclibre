+++ b/gcc/gcc/gcc/cppfiles.c
@@ -204,6 +204,63 @@
 
 #ifdef __riscos__
 #include <unixlib/local.h>
+#else
+/* Modified 2026 for ArcLibre: RISC OS filenames are case-insensitive, as are
+   the macOS volumes the restored sources were maintained on.  When PATH is
+   not found exactly, give each missing component its unique case-insensitive
+   match in its directory and open that.  FILE->path keeps the spelling the
+   source used, as there, so __FILE__ and line markers are unchanged.  */
+static int
+open_file_any_case (const char *path)
+{
+  size_t len = strlen (path);
+  char *out = xmalloc (len + 1);
+  size_t start;
+  int fd = -1;
+
+  memcpy (out, path, len + 1);
+  for (start = out[0] == '/'; start < len; )
+    {
+      size_t stop = start;
+      char saved;
+      struct stat st;
+
+      while (stop < len && out[stop] != '/')
+	stop++;
+      saved = out[stop];
+      out[stop] = '\0';
+      if (stop != start && lstat (out, &st) != 0)
+	{
+	  DIR *dir;
+	  struct dirent *entry;
+	  unsigned int matches = 0;
+
+	  if (start > 1)
+	    out[start - 1] = '\0';
+	  dir = opendir (start == 0 ? "." : start == 1 ? "/" : out);
+	  if (start > 1)
+	    out[start - 1] = '/';
+	  if (dir != NULL)
+	    {
+	      while ((entry = readdir (dir)) != NULL)
+		if (!strcasecmp (entry->d_name, out + start) && matches++ == 0)
+		  memcpy (out + start, entry->d_name, stop - start);
+	      closedir (dir);
+	    }
+	  if (matches != 1)
+	    {
+	      free (out);
+	      errno = ENOENT;
+	      return -1;
+	    }
+	}
+      out[stop] = saved;
+      start = stop + 1;
+    }
+  fd = open (out, O_RDONLY | O_NOCTTY | O_BINARY, 0666);
+  free (out);
+  return fd;
+}
 #endif
 
