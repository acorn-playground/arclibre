+/* Modified 2026 for ArcLibre: RISC OS filenames are case-insensitive, as are
+   the macOS volumes the restored sources were maintained on.  When a name is
+   not found exactly, give each missing component its unique case-insensitive
+   match in its directory.  Exact names are always tried first; an ambiguous
+   or absent component fails.  lastToo false keeps the final component as
+   given, for the ,xyz filetype search below.  */
+#  include <dirent.h>
+#  include <strings.h>
+static bool
+ResolveCase (const char *fileName, bool lastToo, char *out, size_t outSize)
+{
+  size_t len = strlen (fileName);
+  if (len >= outSize)
+    return false;
+  memcpy (out, fileName, len + 1);
+  const char *lastSep = strrchr (out, '/');
+  size_t end = lastToo ? len : lastSep ? (size_t)(lastSep - out) : 0;
+  bool changed = false;
+  for (size_t start = out[0] == '/' ? 1 : 0; start < end; /* */)
+    {
+      size_t stop = start;
+      while (stop < len && out[stop] != '/')
+	++stop;
+      char saved = out[stop];
+      out[stop] = '\0';
+      struct stat cinfo;
+      if (stop != start && lstat (out, &cinfo) != 0)
+	{
+	  DIR *dirP;
+	  if (start == 0)
+	    dirP = opendir (".");
+	  else if (start == 1)
+	    dirP = opendir ("/");
+	  else
+	    {
+	      out[start - 1] = '\0';
+	      dirP = opendir (out);
+	      out[start - 1] = '/';
+	    }
+	  unsigned matches = 0;
+	  char match[NAME_MAX + 1];
+	  if (dirP != NULL)
+	    {
+	      const struct dirent *entryP;
+	      while ((entryP = readdir (dirP)) != NULL)
+		if (!strcasecmp (entryP->d_name, out + start) && matches++ == 0)
+		  memcpy (match, entryP->d_name, stop - start);
+	      closedir (dirP);
+	    }
+	  if (matches != 1)
+	    return false;
+	  memcpy (out + start, match, stop - start);
+	  changed = true;
+	}
+      out[stop] = saved;
+      start = stop + 1;
+    }
+  return changed;
+}
 #endif
 
