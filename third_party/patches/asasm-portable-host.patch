+/* Modified 2026 for ArcLibre: host character classification.
+ *
+ * AsAsm adopts the user's locale (setlocale in main.c).  In the macOS UTF-8
+ * locales the restored sources were maintained under, isspace() is true for
+ * the Latin-1 no-break space, 0xA0; glibc's UTF-8 locales classify no byte
+ * above 0x7F.  Treat that byte as blank on every host, so a source line of
+ * no-break spaces (Kernel s.vdu.vdudecl) assembles as it does there.  Signed
+ * char arguments are unaffected, as on macOS.  No other class is changed.
+ */
+#ifndef ARCLIBRE_HOSTCTYPE_H
+#define ARCLIBRE_HOSTCTYPE_H
+#include <ctype.h>
+static inline int
+arclibre_isspace (int c)
+{
+  return c == 0xA0 || isspace (c);
+}
+#undef isspace
+#define isspace(c) arclibre_isspace (c)
+#endif
